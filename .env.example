NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only 32-byte secret (64 hex characters or 43 base64url characters).
# Never prefix this value with NEXT_PUBLIC and never commit a real value.
RAVOGE_ENROLLMENT_TOKEN_KEY=

# Owner equipment photo scanning. Keep the API key server-only.
EQUIPMENT_SCAN_ENABLED=false
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.4-mini-2026-03-17

# Server-only Resend API for invitation delivery. Keep the protected key in
# Netlify Functions / Production only; previews safely offer the copy-link fallback.
RESEND_API_KEY=
RAVOGE_EMAIL_FROM=Ravoge <hello@ravoge.com>
RAVOGE_EMAIL_REPLY_TO=hello@ravoge.com

# Legacy SMTP configuration is retained but not read by invitation sending.
RAVOGE_SMTP_HOST=smtp.office365.com
RAVOGE_SMTP_PORT=587
RAVOGE_SMTP_USER=hello@ravoge.com
RAVOGE_SMTP_PASSWORD=
RAVOGE_APP_URL=https://ravoge.com
